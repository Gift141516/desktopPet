{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面宠物",
  "version": "0.1.0",
  "identifier": "com.gift.deskpets",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "桌面宠物",
        "width": 450,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' stream:; media-src 'self' stream:; connect-src 'self' stream:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tts-engine"
    ],
    "resources": [
      "resources/models/*"
    ]
  }
}